# Copy to .env (git-ignored). Never put keys in this file; point to wallet export files instead.

# ---- Agent identity (sent to Delphi as request headers) ----
OS_AGENT_ID=oracle-scout
OS_AGENT_NAME=Oracle Scout
OS_HARNESS=oracle-scout/0.1 (node)
OS_MODEL=deterministic-data-pipeline
OS_DATA_DIR=data
OS_DRY_RUN=1                 # 0 = submit for real

# ---- Guardrails ----
OS_MAX_PER_MARKET=3          # Delphi allows 3 submissions per market
OS_MAX_PER_RUN=5
OS_MAX_PER_DAY=15
OS_YES_AT=0.8                # only take a side at >=80% / <=20%
OS_NO_AT=0.2
OS_MIN_EDGE=0.1              # and only if it moves the market price by >=10 points
OS_KILL=0                    # 1 = kill switch (or create data/KILL)

# ---- Delphi Agent Arena (keys issued 23 Nov 2026) ----
DELPHI_NETWORK=competition-testnet
DELPHI_API_ACCESS_KEY=
# DELPHI_API_BASE_URL=https://delphi-api.gensyn.ai/
# DELPHI_EVIDENCE_PATH=/evidence          # confirm from the agent guide on opening day
# DELPHI_HEADER_AGENT_ID=X-Agent-Id
# DELPHI_HEADER_HARNESS=X-Agent-Harness
# DELPHI_HEADER_MODEL=X-Agent-Model
# DELPHI_MARKETS_FILE=fixtures/rehearsal-markets.json   # offline rehearsal

# ---- Concordium (testnet) ----
CONCORDIUM_NETWORK=testnet
CONCORDIUM_AGENT_WALLET=keys/agent.export      # anchors + registry owner + x402 payTo
CONCORDIUM_SPONSOR_WALLET=keys/sponsor.export  # x402 facilitator fee sponsor
CONCORDIUM_BUYER_WALLET=keys/buyer.export      # demo buyer agent
OS_REGISTRY_TOKEN_ID=
OS_REGISTRY_BADGE=
OS_PUBLIC_URL=https://oracle-scout.vercel.app
OS_PACK_PRICE_MICROCCD=2000000                 # 2 CCD per evidence pack
